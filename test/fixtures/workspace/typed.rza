layout Entry: key:i64, value:i64, half:u16, signed:i16
res entries, field, Entry[2]
med entries_m, entries, field
mov %r0, 0
mov %r1, 42
store [entries_m + %r0].key, %r1
store [entries_m + %r0].value, %r1
load %r2, [entries_m + 0].value
print %r2
mov.i8 %r3, 0xff
add.u8 %r4, %r0, 255
mov.i16 %r5, 0x8000
add.u16 %r6, %r0, 65535
store.u16 [entries_m + 0].half, %r1
store.i16 [entries_m + 0].signed, %r5
print %r3
print %r4
print %r5
print %r6
ret
