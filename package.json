{
  "name": "rza",
  "displayName": "RZA Language Support",
  "description": "Syntax highlighting and diagnostics for RZA (.rza) via rez3asm",
  "version": "0.5.0",
  "publisher": "rez3",
  "repository": {
    "type": "git",
    "url": "https://github.com/wtorso/rza-vscode.git"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:rza"
  ],
  "main": "./client.js",
  "contributes": {
    "languages": [
      {
        "id": "rza",
        "extensions": [
          ".rza"
        ],
        "aliases": [
          "RZA",
          "rza"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rza",
        "scopeName": "source.rza",
        "path": "./syntaxes/rza.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "RZA",
      "properties": {
        "rez3.transpilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the RZA compiler. Empty uses the default source-checkout location"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node test/integration/runTests.js",
    "test:package": "node --test test/package/*.test.js",
    "package": "node -e \"require('fs').mkdirSync('build',{recursive:true})\" && vsce package --out build/rza-0.5.0.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "jszip": "^3.10.2",
    "mocha": "^12.0.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
