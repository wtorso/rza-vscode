{
  "name": "rza",
  "displayName": "REZ3-ASM Language Support",
  "description": "Syntax highlighting and diagnostics for REZ3-ASM (.rza) via the rez3asm transpiler",
  "version": "0.2.0",
  "publisher": "rez3",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:rza"
  ],
  "main": "./client.js",
  "contributes": {
    "languages": [
      {
        "id": "rza",
        "extensions": [
          ".rza"
        ],
        "aliases": [
          "REZ3-ASM",
          "rza"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rza",
        "scopeName": "source.rza",
        "path": "./syntaxes/rza.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "REZ3-ASM",
      "properties": {
        "rez3.transpilerPath": {
          "type": "string",
          "default": "",
          "description": "Путь к rez3asm (rez3asm.exe). Пусто = <extensionRoot>/../../rez3asm.exe"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
